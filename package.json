{
  "name": "vite-react-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:headers": "playwright test tests/e2e/security-headers.spec.ts",
    "test:e2e:live": "playwright test tests/e2e/live-groq.spec.ts --project=desktop",
    "check:security": "node scripts/security-check.mjs",
    "audit:prod": "npm audit --omit=dev",
    "check": "npm run lint && npm run test && npm run build && npm run check:security",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
